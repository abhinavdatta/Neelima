{
  "id": "generic-template",
  "name": "Generic (fill with the Adapter Inspector)",
  "url": "https://example.com/",
  "selectors": {
    "input": "textarea",
    "send_button": "button[type=submit]",
    "stop_button": null,
    "messages": "main",
    "new_chat": null,
    "logged_in": "textarea",
    "logged_out": "a[href*=\"login\"], button[aria-label*=\"Sign in\"], [data-testid*=\"login\"]"
  },
  "input": { "kind": "textarea", "max_chars": 8000 },
  "quiet_ms": 2000,
  "response_timeout_ms": 300000,
  "built_in": true,
  "allowed_domain": "example.com",
  "auth_domains": [],
  "login_url_patterns": ["login", "signin", "sign-in", "auth", "signup", "register"]
}
